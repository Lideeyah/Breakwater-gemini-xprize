# Breakwater Configuration

# Google AI Studio key for the Gemini Flash semantic evaluator.
# Get a key at https://aistudio.google.com/apikey
# Without it, Breakwater still trips loops via the deterministic heuristic engine.
GEMINI_API_KEY=your_google_ai_studio_key

# Gemini Flash model (1.5 Flash was retired; default is the current stable Flash).
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=12000

# Ports
PROXY_PORT=3001          # Fastify reverse proxy + WebSocket (/ws)
# Next.js dashboard runs on 3000 (next dev/start)

# Dashboard -> proxy WebSocket (optional overrides; sensible defaults otherwise)
# NEXT_PUBLIC_PROXY_PORT=3001
# NEXT_PUBLIC_PROXY_WS_URL=ws://localhost:3001/ws

# Real passthrough (protect any OpenAI-compatible agent with one URL swap).
# Default upstream is Gemini's OpenAI-compatible endpoint, so it works out of the
# box with GEMINI_API_KEY. Point at OpenAI to protect an OpenAI agent instead.
# UPSTREAM_LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# UPSTREAM_API_KEY=            # fallback key when the caller sends no Authorization
# PASSTHROUGH_SEMANTIC=1       # set 0 to skip Gemini on the hot path (faster)

# Cost projection model
AGENT_TARGET_MODEL=gpt-4         # model the runaway agent would burn per loop
RUNAWAY_HORIZON_MINUTES=60       # projection horizon for "dollars saved"

# Context-degradation guard + decision SLA
MODEL_CONTEXT_LIMIT=128000       # downstream model hard context wall
CONTEXT_TOKEN_CEILING=120000     # trip the breaker before this many tokens
DECISION_SLA_MS=80               # deterministic decision-latency budget

# Policy defaults (optional overrides)
MAX_REQUESTS_PER_MINUTE=60
MAX_TOKENS_PER_MINUTE=100000
BUDGET_LIMIT_USD=50
LOOP_THRESHOLD=0.85
